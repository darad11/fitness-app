{
  "name": "fitness-app",
  "private": true,
  "version": "0.1.0",
  "description": "Persönliche Fitnessplattform als local-first PWA",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:db": "node tools/test-db.mjs",
    "check:docs": "python3 tools/check_docs.py && python3 tools/feature_inventory_to_csv.py --check && python3 tools/exercise_library_to_md.py --check && python3 tools/exercise_inventory.py --check && python3 tools/sample_templates_from_md.py --check && python3 tools/winterprogramm_to_md.py --check && python3 tools/check_names.py && python3 tools/programs_build.py --check && python3 tools/lebensmittel_auswahl.py --check",
    "check:bundle": "node tools/check-bundle-size.mjs && node tools/check-precache.mjs"
  },
  "dependencies": {
    "barcode-detector": "3.2.2",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1"
  }
}
